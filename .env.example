# Окружение: development | production
NODE_ENV=development
PORT=3000
# 127.0.0.1 за nginx, 0.0.0.0 в Docker
HOST=127.0.0.1
# Публичный адрес сайта: для sitemap, Open Graph и JSON-LD
SITE_URL=http://localhost:3000
DB_PATH=data/app.db

# Хеш пароля администратора (argon2). Сгенерировать: npm run hash-password
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=12
# true, если сайт стоит за nginx/прокси (для верного IP в rate limit)
TRUST_PROXY=false

# Уведомления о новых заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
