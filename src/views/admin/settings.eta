<% layout('./layout') %>
<% const s = it.s %>
<header class="page-head">
  <h1 class="page-title">Настройки</h1>
</header>

<% const section = (title, meta, open, body) => { %>
  <details class="panel acc"<%~ open ? ' open' : '' %>>
    <summary class="acc__head">
      <span class="acc__title"><%= title %></span>
<% if (meta) { %><span class="acc__meta"><%= meta %></span><% } %>
      <svg class="acc__chevron" aria-hidden="true"><use href="#i-chevron-down"/></svg>
    </summary>
    <div class="acc__body"><% body() %></div>
  </details>
<% } %>

<form class="admin-form settings-form acc-list" data-api action="/admin/api/settings">
<% section('Мастер и контакты', s.master_name, true, () => { %>
    <div class="form-grid">
      <div class="field"><label for="st-master">Имя мастера</label><input id="st-master" name="master_name" value="<%= s.master_name %>" required maxlength="60"><p class="field-error" data-error-for="master_name"></p></div>
      <div class="field"><label for="st-studio">Название студии</label><input id="st-studio" name="studio_name" value="<%= s.studio_name %>" required maxlength="60"><p class="field-error" data-error-for="studio_name"></p></div>
      <div class="field"><label for="st-phone">Телефон</label><input id="st-phone" name="phone" value="<%= s.phone %>" type="tel" maxlength="30"></div>
      <div class="field"><label for="st-tg">Telegram (ник без @)</label><input id="st-tg" name="telegram" value="<%= s.telegram %>" maxlength="40" autocapitalize="off" autocorrect="off"></div>
      <div class="field"><label for="st-ig">Instagram, ссылка</label><input id="st-ig" name="instagram" value="<%= s.instagram %>" type="url" placeholder="https://instagram.com/…" maxlength="200"><p class="field-error" data-error-for="instagram"></p></div>
      <div class="field"><label for="st-wa">WhatsApp, ссылка</label><input id="st-wa" name="whatsapp" value="<%= s.whatsapp %>" type="url" placeholder="https://wa.me/375…" maxlength="200"><p class="field-error" data-error-for="whatsapp"></p></div>
    </div>
<% }) %>

<% section('Адрес и карта', [s.city, s.address].filter(Boolean).join(', '), false, () => { %>
    <p class="muted">На первом экране сайта адрес показан кнопкой «Я тут», она открывает Яндекс Карты. Полный адрес виден в футере.</p>
    <div class="form-grid">
      <div class="field"><label for="st-city">Город</label><input id="st-city" name="city" value="<%= s.city %>" maxlength="40"></div>
      <div class="field"><label for="st-metro">Метро или ориентир</label><input id="st-metro" name="metro" value="<%= s.metro %>" maxlength="60"></div>
      <div class="field field--wide"><label for="st-address">Адрес</label><input id="st-address" name="address" value="<%= s.address %>" maxlength="120" placeholder="ул. Притыцкого, 2, студия 14"></div>
      <div class="field field--wide">
        <label for="st-map">Ссылка на Яндекс Карты <span class="muted">необязательно</span></label>
        <input id="st-map" name="map_url" value="<%= s.map_url %>" type="url" maxlength="200" placeholder="https://yandex.by/maps/org/…">
        <p class="field-hint">Откройте студию в Яндекс Картах, нажмите «Поделиться» и вставьте ссылку. Если оставить пустым, карта откроется поиском по городу и адресу.</p>
        <p class="field-error" data-error-for="map_url"></p>
      </div>
      <p class="field--wide"><a class="btn btn--ghost btn--sm" href="<%= it.mapUrl %>" target="_blank" rel="noopener" data-map-preview>Проверить, что откроется <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
    </div>
<% }) %>

<% section('Первый экран и цвет', null, false, () => { %>
    <div class="form-grid">
      <div class="field field--wide">
        <label for="st-title">Заголовок</label>
        <textarea id="st-title" name="hero_title" rows="2" maxlength="80" required><%= s.hero_title %></textarea>
        <p class="field-hint">Каждая строка с новой строки. Если не разбивать, сайт разобьёт сам.</p>
        <p class="field-error" data-error-for="hero_title"></p>
      </div>
      <div class="field field--wide"><label for="st-sub">Подзаголовок</label><textarea id="st-sub" name="hero_subtitle" rows="3" maxlength="240"><%= s.hero_subtitle %></textarea></div>
      <div class="field field--wide"><label for="st-seo">Описание для поисковиков</label><textarea id="st-seo" name="seo_description" rows="3" maxlength="200"><%= s.seo_description %></textarea><p class="field-hint">Показывается в Google и Яндексе под названием сайта. До 160 символов.</p></div>
      <div class="field field--wide">
        <label for="st-accent">Акцентный цвет</label>
        <div class="color-field">
          <input id="st-accent" name="accent_color" type="color" value="<%= s.accent_color %>">
          <span class="muted" data-color-value><%= s.accent_color %></span>
          <button type="button" class="btn btn--ghost btn--sm" data-color-reset="#F2D2D8">Вернуть розовый</button>
        </div>
        <p class="field-error" data-error-for="accent_color"></p>
      </div>
    </div>
<% }) %>

<% const repeat = (key, items, label, rows) => { %>
    <div class="repeat-grid">
<% for (const [i, item] of items.entries()) { %>
      <fieldset class="repeat-item">
        <legend><%= label %> <%= i + 1 %></legend>
        <label class="sr-only" for="<%= key %>-t-<%= i %>">Заголовок: <%= label %> <%= i + 1 %></label>
        <input id="<%= key %>-t-<%= i %>" name="<%= key %>[<%= i %>][title]" value="<%= item.title %>" placeholder="Заголовок" maxlength="80">
        <label class="sr-only" for="<%= key %>-x-<%= i %>">Текст: <%= label %> <%= i + 1 %></label>
        <textarea id="<%= key %>-x-<%= i %>" name="<%= key %>[<%= i %>][text]" rows="<%= rows %>" placeholder="Текст" maxlength="400"><%= item.text %></textarea>
      </fieldset>
<% } %>
    </div>
<% } %>

<% section('Блок «Почему я»', s.why_title, false, () => { %>
    <div class="field"><label for="st-why">Заголовок в круге</label><input id="st-why" name="why_title" value="<%= s.why_title %>" maxlength="40"></div>
<% repeat('why_items', it.whyItems, 'Карточка', 2) %>
<% }) %>

<% section('Как проходит визит', `${s.visit_steps.length} шага`, false, () => { repeat('visit_steps', it.visitSteps, 'Шаг', 3) }) %>

<% section('Правила записи', `${s.rules.length} правила`, false, () => { repeat('rules', it.rules, 'Правило', 2) }) %>

<% section('Чек-лист «Как подготовиться»', `${s.checklist.length} пунктов`, false, () => { %>
    <p class="muted">Пустые строки не показываются. Сохраните, чтобы появились новые пустые поля.</p>
    <div class="checklist-inputs">
<% for (const [i, item] of it.checklist.entries()) { %>
      <label class="sr-only" for="cl-<%= i %>">Пункт <%= i + 1 %></label>
      <input id="cl-<%= i %>" name="checklist[<%= i %>]" value="<%= item %>" maxlength="160" placeholder="Новый пункт">
<% } %>
    </div>
<% }) %>

  <div class="sticky-save">
    <p class="form-error" data-form-error role="alert"></p>
    <button class="btn btn--dark" type="submit">Сохранить настройки</button>
  </div>
</form>

<section class="integrations" aria-labelledby="integrations-title">
  <div class="section-bar"><h2 class="h3" id="integrations-title">Уведомления и аналитика</h2></div>
  <div class="acc-list">
    <details class="panel acc"<%~ !s.telegram_enabled ? ' open' : '' %>>
      <summary class="acc__head">
        <span class="acc__title">Telegram <span class="tag<%= s.telegram_enabled ? ' tag--accent' : '' %>" data-tg-state><%= s.telegram_enabled ? 'включено' : 'выключено' %></span></span>
        <span class="acc__meta"><%= s.telegram_enabled ? 'Записи с сайта приходят в «' + (s.telegram_chat_title || s.telegram_chat_id) + '»' : 'Уведомления о новых записях в группу' %></span>
        <svg class="acc__chevron" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </summary>
      <form class="admin-form acc__body" data-api action="/admin/api/integrations/telegram" data-telegram-form>
        <ol class="steps-hint">
          <li>В Telegram откройте <a href="https://t.me/BotFather" target="_blank" rel="noopener">@BotFather</a>, отправьте <b>/newbot</b> и скопируйте токен.</li>
          <li>Добавьте бота в группу, куда должны приходить записи, и напишите там любое сообщение.</li>
          <li>Вставьте токен ниже, нажмите «Найти группы» и выберите группу.</li>
        </ol>
        <div class="field">
          <label for="tg-token">Токен бота</label>
          <input id="tg-token" name="telegram_bot_token" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                 placeholder="<%= it.tokenMask ? 'сохранён ' + it.tokenMask + ' — вставьте новый, чтобы заменить' : '123456789:AAH…' %>" data-tg-token>
          <p class="field-error" data-error-for="telegram_bot_token"></p>
        </div>
        <div class="field">
          <label for="tg-chat">Группа</label>
          <div class="input-action">
            <input id="tg-chat" name="telegram_chat_id" value="<%= s.telegram_chat_id %>" inputmode="numeric" placeholder="-100…" autocomplete="off" data-tg-chat>
            <button type="button" class="btn btn--ghost" data-tg-find>Найти группы</button>
          </div>
          <input type="hidden" name="telegram_chat_title" value="<%= s.telegram_chat_title %>" data-tg-title>
          <p class="field-hint" data-tg-title-hint><%= s.telegram_chat_title ? 'Выбрана группа «' + s.telegram_chat_title + '»' : '' %></p>
          <p class="field-error" data-error-for="telegram_chat_id"></p>
          <ul class="chat-picks" data-tg-chats hidden></ul>
        </div>
        <label class="check-row"><span>Отправлять уведомления о новых записях</span><span class="switch"><input type="checkbox" name="telegram_enabled"<%~ s.telegram_enabled ? ' checked' : '' %>></span></label>
        <p class="form-error" data-form-error role="alert"></p>
        <div class="form-actions">
          <button type="button" class="btn btn--ghost" data-tg-test>Отправить тест</button>
          <button class="btn btn--dark" type="submit">Сохранить</button>
        </div>
      </form>
    </details>

    <details class="panel acc"<%~ !s.metrika_id ? ' open' : '' %>>
      <summary class="acc__head">
        <span class="acc__title">Яндекс Метрика <span class="tag<%= s.metrika_id ? ' tag--accent' : '' %>"><%= s.metrika_id ? 'подключена' : 'не подключена' %></span></span>
        <span class="acc__meta"><%= s.metrika_id ? 'Счётчик ' + s.metrika_id : 'Статистика посещений сайта' %></span>
        <svg class="acc__chevron" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </summary>
      <form class="admin-form acc__body" data-api action="/admin/api/integrations/metrika" data-reload>
        <ol class="steps-hint">
          <li>Создайте счётчик на <a href="https://metrika.yandex.ru/add" target="_blank" rel="noopener">metrika.yandex.ru</a>, адрес сайта: <b><%= it.siteHost %></b>.</li>
          <li>Скопируйте номер счётчика (цифры над названием) и вставьте ниже.</li>
          <li>Чтобы видеть, сколько людей записались, добавьте в Метрике цель «JavaScript-событие» с идентификатором <b>booking</b>.</li>
        </ol>
        <div class="field">
          <label for="ym-id">Номер счётчика</label>
          <input id="ym-id" name="metrika_id" value="<%= s.metrika_id %>" inputmode="numeric" placeholder="98765432" autocomplete="off">
          <p class="field-hint">Оставьте пустым, чтобы отключить Метрику.</p>
          <p class="field-error" data-error-for="metrika_id"></p>
        </div>
        <label class="check-row"><span>Вебвизор (запись действий посетителей)</span><span class="switch"><input type="checkbox" name="metrika_webvisor"<%~ s.metrika_webvisor ? ' checked' : '' %>></span></label>
        <p class="form-error" data-form-error role="alert"></p>
        <div class="form-actions">
<% if (s.metrika_id) { %>
          <a class="btn btn--ghost" href="https://metrika.yandex.ru/dashboard?id=<%= s.metrika_id %>" target="_blank" rel="noopener">Открыть отчёты <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
<% } %>
          <button class="btn btn--dark" type="submit">Сохранить</button>
        </div>
      </form>
    </details>
  </div>
</section>

<section class="reviews-admin" aria-labelledby="reviews-title">
  <div class="section-bar">
    <h2 class="h3" id="reviews-title">Отзывы · <%= it.reviews.length %></h2>
    <button type="button" class="btn btn--ghost btn--sm" data-open-dialog="review-dialog"><svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Добавить</button>
  </div>
  <ul class="acc-list" data-sortable="/admin/api/reviews/reorder">
<% for (const r of it.reviews) { %>
    <li data-id="<%= r.id %>" data-row>
      <details class="panel acc">
        <summary class="acc__head">
          <span class="acc__title"><%= r.author %> <span class="acc__stars" aria-label="<%= r.rating %> из 5"><%= '★'.repeat(r.rating) %></span><% if (!r.is_active) { %> <span class="tag">скрыт</span><% } %></span>
          <span class="acc__meta acc__meta--clip"><%= r.text %></span>
          <svg class="acc__chevron" aria-hidden="true"><use href="#i-chevron-down"/></svg>
        </summary>
        <form class="admin-form acc__body" data-api action="/admin/api/reviews/<%= r.id %>">
          <div class="form-grid">
            <div class="field"><label for="ra-<%= r.id %>">Имя</label><input id="ra-<%= r.id %>" name="author" value="<%= r.author %>" maxlength="60" required></div>
            <div class="field"><label for="rr-<%= r.id %>">Оценка</label>
              <select id="rr-<%= r.id %>" name="rating" class="select"><% for (let n = 5; n >= 1; n--) { %><option value="<%= n %>"<%~ n === r.rating ? ' selected' : '' %>><%= n %> ★</option><% } %></select>
            </div>
            <div class="field field--wide"><label for="rt-<%= r.id %>">Текст отзыва</label><textarea id="rt-<%= r.id %>" name="text" rows="4" maxlength="800" required><%= r.text %></textarea><p class="field-error" data-error-for="text"></p></div>
            <label class="check-row field--wide"><span>Показывать на сайте</span><span class="switch"><input type="checkbox" name="is_active"<%~ r.is_active ? ' checked' : '' %>></span></label>
          </div>
          <div class="form-actions">
            <span class="move-btns move-btns--always">
              <button type="button" class="icon-btn icon-btn--plain" data-move="up" aria-label="Выше"><svg aria-hidden="true"><use href="#i-up"/></svg></button>
              <button type="button" class="icon-btn icon-btn--plain" data-move="down" aria-label="Ниже"><svg aria-hidden="true"><use href="#i-down"/></svg></button>
            </span>
            <button type="button" class="icon-btn icon-btn--plain icon-btn--danger" data-api-post="/admin/api/reviews/<%= r.id %>/delete" data-confirm="Удалить отзыв <%= r.author %>?" data-remove-row aria-label="Удалить отзыв"><svg aria-hidden="true"><use href="#i-trash"/></svg></button>
            <button class="btn btn--dark" type="submit">Сохранить</button>
          </div>
        </form>
      </details>
    </li>
<% } %>
  </ul>
</section>

<dialog class="admin-dialog" id="review-dialog" aria-labelledby="review-dialog-title">
  <form class="sheet admin-form" data-api action="/admin/api/reviews" data-reload>
    <div class="sheet__head">
      <h2 class="sheet__title" id="review-dialog-title">Новый отзыв</h2>
      <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
    </div>
    <div class="sheet__body">
      <div class="form-grid">
        <div class="field"><label for="ra-new">Имя клиентки</label><input id="ra-new" name="author" maxlength="60" required><p class="field-error" data-error-for="author"></p></div>
        <div class="field"><label for="rr-new">Оценка</label><select id="rr-new" name="rating" class="select"><% for (let n = 5; n >= 1; n--) { %><option value="<%= n %>"><%= n %> ★</option><% } %></select></div>
        <div class="field field--wide"><label for="rt-new">Текст отзыва</label><textarea id="rt-new" name="text" rows="5" maxlength="800" required></textarea><p class="field-error" data-error-for="text"></p></div>
      </div>
      <input type="hidden" name="is_active" value="on">
      <p class="form-error" data-form-error role="alert"></p>
    </div>
    <div class="sheet__foot">
      <button type="button" class="btn btn--ghost" data-close-dialog>Отмена</button>
      <button class="btn btn--dark" type="submit">Добавить</button>
    </div>
  </form>
</dialog>
