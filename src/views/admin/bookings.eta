<% layout('./layout') %>
<%
  const STATUS_FILTER_LABELS = { new: 'Новые', confirmed: 'Подтверждённые', cancelled: 'Отменённые', done: 'Выполненные' };
  const plural = (n, one, few, many) => (n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? few : many);
  // «5 ч», «4,5 ч» — коротко для клетки календаря
  const shortHours = (min) => `${String(Math.round(min / 30) / 2).replace('.', ',')} ч`;
%>
<header class="page-head">
  <h1 class="page-title">Записи</h1>
  <div class="page-head__actions">
    <nav class="view-switch" aria-label="Вид">
      <a class="view-switch__item" href="?view=list" aria-label="Списком"<%~ it.view === 'list' ? ' aria-current="true"' : '' %>><svg aria-hidden="true"><use href="#i-list"/></svg></a>
      <a class="view-switch__item" href="?view=calendar" aria-label="Календарём"<%~ it.view === 'calendar' ? ' aria-current="true"' : '' %>><svg aria-hidden="true"><use href="#i-calendar"/></svg></a>
    </nav>
    <button type="button" class="btn btn--dark page-action" data-open-dialog="booking-dialog" aria-label="Добавить запись">
      <svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg><span class="page-action__label">Добавить запись</span>
    </button>
  </div>
</header>

<% if (it.view === 'calendar') { const cal = it.cal; %>
<div class="cal" data-calendar data-month="<%= cal.month %>" data-selected="<%= cal.selected %>">
  <div class="cal-top" data-cal-top>
    <div class="cal-nav">
      <a class="icon-btn icon-btn--plain" href="?view=calendar&month=<%= cal.prev %>" data-cal-shift="-1" aria-label="Предыдущий месяц"><svg aria-hidden="true"><use href="#i-chevron-left"/></svg></a>
      <h2 class="cal-nav__title" aria-live="polite"><%= cal.title %></h2>
<% if (cal.month !== cal.currentMonth) { %>
      <a class="cal-nav__today" href="?view=calendar" data-cal-shift="0">Сегодня</a>
<% } %>
      <a class="icon-btn icon-btn--plain" href="?view=calendar&month=<%= cal.next %>" data-cal-shift="1" aria-label="Следующий месяц"><svg aria-hidden="true"><use href="#i-chevron-right"/></svg></a>
    </div>

    <div class="cal-sheet" data-cal-swipe>
      <div class="cal-weekdays" aria-hidden="true"><span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Вс</span></div>
      <div class="cal-grid" role="grid" aria-label="<%= cal.title %>">
<% for (const week of cal.weeks) { %>
        <div class="cal-week" role="row">
<% for (const d of week) {
     const cls = ['cal-day', d.inMonth ? '' : 'is-other', d.isToday ? 'is-today' : '', d.isPast ? 'is-past' : '', d.hours ? '' : 'is-off', d.count ? 'has-items' : ''].filter(Boolean).join(' ');
     const label = `${d.day}${d.count ? `, ${d.count} ${plural(d.count, 'запись', 'записи', 'записей')}, ${shortHours(d.busyMin)}` : d.hours ? ', свободно' : ', выходной'}`; %>
<% if (d.inMonth) { %>
          <button type="button" role="gridcell" class="<%= cls %>" data-cal-day="<%= d.iso %>" aria-pressed="<%= d.iso === cal.selected %>" aria-label="<%= label %>" data-load="<%= d.load.toFixed(2) %>">
<% } else { %>
          <a role="gridcell" class="<%= cls %>" href="?view=calendar&month=<%= d.iso.slice(0, 7) %>&day=<%= d.iso %>" data-cal-shift="<%= d.iso < cal.month ? -1 : 1 %>" aria-label="<%= label %>" data-load="<%= d.load.toFixed(2) %>">
<% } %>
            <span class="cal-day__num"><%= d.day %></span>
            <span class="cal-day__hours"><%= d.count ? shortHours(d.busyMin) : '' %></span>
            <span class="cal-day__bar" aria-hidden="true"></span>
<% if (d.hasNew) { %><span class="cal-day__new" aria-hidden="true"></span><% } %>
          <%~ d.inMonth ? '</button>' : '</a>' %>
<% } %>
        </div>
<% } %>
      </div>
    </div>

    <dl class="cal-total">
      <div><dt>Записей</dt><dd><%= cal.total.count %></dd></div>
      <div><dt>Работы</dt><dd><%= shortHours(cal.total.busyMin) %></dd></div>
      <div><dt>Доход</dt><dd><%= cal.total.revenue %> <small>BYN</small></dd></div>
      <div><dt>Свободно</dt><dd><%= cal.total.freeMin ? shortHours(cal.total.freeMin) : '—' %></dd></div>
    </dl>
  </div>

<% for (const d of cal.days) { %>
  <section class="cal-panel" data-cal-panel="<%= d.iso %>" aria-labelledby="p-<%= d.iso %>"<%~ d.iso === cal.selected ? '' : ' hidden' %>>
    <div class="cal-panel__head">
      <h2 class="cal-panel__title" id="p-<%= d.iso %>"><%= it.formatDateLong(d.iso) %><% if (d.isToday) { %> <span class="tag tag--accent">сегодня</span><% } %></h2>
      <p class="cal-panel__meta"><%= d.hours ? `${it.formatTime(d.hours.start)}–${it.formatTime(d.hours.end)}` : 'Выходной' %><% if (d.count) { %> · занято <%= it.formatDuration(d.busyMin) %> · <%= d.revenue %> BYN<% } %></p>
    </div>
<% if (d.items.length) { %>
    <ul class="booking-list">
<% for (const b of d.items) { %>
      <%~ include('./_booking-card', { b, statusLabels: it.statusLabels, formatPhone: it.formatPhone }) %>
<% } %>
    </ul>
<% } else { %>
    <p class="cal-panel__empty muted"><%= d.hours ? 'Записей нет — день свободен.' : 'Выходной, записей нет.' %></p>
<% } %>
<% if (!d.isPast) { %>
    <button type="button" class="btn btn--ghost cal-panel__add" data-open-dialog="booking-dialog" data-quick-date="<%= d.iso %>">
      <svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg>Записать на этот день
    </button>
<% } %>
  </section>
<% } %>
</div>
<% } else { %>
<nav class="filters" aria-label="Фильтр записей" data-bookings-filters>
  <div class="segmented segmented--full" role="group" aria-label="Период" data-segmented>
    <span class="segmented__thumb" aria-hidden="true"></span>
<% for (const p of it.periods) { %>
    <a class="segmented__item" href="?period=<%= p.value %><%= it.status ? '&status=' + it.status : '' %>"<%~ p.value === it.period ? ' aria-current="true"' : '' %>><%= p.label %></a>
<% } %>
  </div>
  <div class="chip-scroll" role="group" aria-label="Статус">
    <a class="filter-chip" href="?period=<%= it.period %>"<%~ !it.status ? ' aria-current="true"' : '' %>>Все</a>
<% for (const s of it.statuses) { %>
    <a class="filter-chip" href="?period=<%= it.period %>&status=<%= s.value %>"<%~ s.value === it.status ? ' aria-current="true"' : '' %>>
      <%= STATUS_FILTER_LABELS[s.value] %><% if (s.value === 'new' && it.statusCounts.new) { %> <span class="filter-chip__count"><%= it.statusCounts.new %></span><% } %>
    </a>
<% } %>
  </div>
</nav>

<div class="bookings-list" data-bookings-list>
<% if (!it.groups.length) { %>
<div class="panel empty-state">
  <span class="empty-state__icon" aria-hidden="true"><svg><use href="#i-calendar"/></svg></span>
  <p class="empty-state__title">Записей нет</p>
  <p class="muted">Когда клиенты запишутся на сайте, они появятся здесь. Запись по телефону можно добавить кнопкой «+».</p>
</div>
<% } %>

<% for (const group of it.groups) { %>
<section class="day-group" aria-labelledby="d-<%= group.date %>">
  <h2 class="day-group__title" id="d-<%= group.date %>">
    <span><%= group.label %></span>
<% if (group.isToday) { %><span class="tag tag--accent">сегодня</span><% } else if (group.isTomorrow) { %><span class="tag">завтра</span><% } %>
    <span class="day-group__count"><%= group.items.length %></span>
  </h2>
  <ul class="booking-list">
<% for (const b of group.items) { %>
    <%~ include('./_booking-card', { b, statusLabels: it.statusLabels, formatPhone: it.formatPhone }) %>
<% } %>
  </ul>
</section>
<% } %>

</div>
<% } %>

<dialog class="admin-dialog quick" id="booking-dialog" aria-labelledby="booking-dialog-title">
  <form class="sheet admin-form" data-api action="/admin/api/bookings" data-quick-form>
    <div class="sheet__head">
      <h2 class="sheet__title" id="booking-dialog-title">Новая запись</h2>
      <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
    </div>
    <div class="sheet__body">
      <fieldset class="quick__step">
        <legend class="quick__label">Услуга</legend>
        <div class="quick-services">
<% for (const s of it.services.filter((s) => s.is_active)) { %>
          <label class="quick-option">
            <input type="radio" name="service_id" value="<%= s.id %>" data-duration="<%= s.duration_min %>" data-title="<%= s.title %>" required>
            <span class="quick-option__title"><%= s.title %></span>
            <span class="quick-option__meta"><%= s.price_byn %> BYN · <%= it.formatDuration(s.duration_min) %></span>
          </label>
<% } %>
        </div>
        <p class="field-error" data-error-for="service_id"></p>
      </fieldset>

      <fieldset class="quick__step" data-quick-step="date" disabled>
        <legend class="quick__label">Дата</legend>
        <div class="quick-dates" data-quick-dates><p class="muted">Сначала выберите услугу</p></div>
        <p class="field-error" data-error-for="date"></p>
      </fieldset>

      <fieldset class="quick__step" data-quick-step="time" disabled>
        <legend class="quick__label">Время</legend>
        <div class="quick-times" data-quick-times><p class="muted">Выберите дату</p></div>
        <details class="quick-custom" data-quick-custom>
          <summary>Другое время</summary>
          <div class="quick-custom__body">
            <label class="time-field"><span class="time-field__label">в</span><input type="time" step="300" data-quick-custom-time aria-label="Время начала"></label>
            <p class="field-hint">Для времени вне сетки или поверх другой записи: запись сохранится, даже если время занято.</p>
          </div>
        </details>
        <input type="hidden" name="time">
        <input type="hidden" name="date">
        <input type="hidden" name="force">
        <p class="field-error" data-error-for="time"></p>
      </fieldset>

      <fieldset class="quick__step">
        <legend class="quick__label">Клиентка</legend>
        <div class="quick-client-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-quick-contacts hidden><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg>Из контактов</button>
          <button type="button" class="btn btn--ghost btn--sm" data-open-dialog="client-picker"><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg>Выбрать из базы</button>
        </div>
        <div class="form-grid">
          <div class="field">
            <label for="b-name">Имя</label>
            <input id="b-name" name="client_name" required maxlength="60" autocomplete="off" autocapitalize="words" enterkeyhint="next">
            <p class="field-error" data-error-for="client_name"></p>
          </div>
          <div class="field">
            <label for="b-contact">Телефон</label>
            <div class="phone-field">
              <span class="phone-field__code" aria-hidden="true">+375</span>
              <input id="b-contact" name="contact" required maxlength="14" type="tel" inputmode="numeric" autocomplete="off" enterkeyhint="done" placeholder="(29) 123-45-67" data-phone>
            </div>
            <p class="field-error" data-error-for="contact"></p>
          </div>
        </div>
        <ul class="client-suggest" data-client-suggest hidden aria-label="Сохранённые клиентки"></ul>
        <p class="field-hint">Начните вводить имя или номер — появятся сохранённые клиентки. Можно вставить «Аня +375 29 123-45-67» — имя и номер разложатся сами.</p>
      </fieldset>

      <details class="quick-more">
        <summary>Эффект, комментарий, статус</summary>
        <div class="form-grid quick-more__body">
          <div class="field">
            <label for="b-effect">Эффект</label>
            <select id="b-effect" name="effect_slug" class="select">
              <option value="">Не выбран</option>
<% for (const e of it.effects) { %><option value="<%= e.slug %>"><%= e.name %></option><% } %>
            </select>
          </div>
          <div class="field">
            <label for="b-status">Статус</label>
            <select id="b-status" name="status" class="select">
              <option value="confirmed">Подтверждена</option>
              <option value="new">Новая</option>
            </select>
          </div>
          <div class="field field--wide">
            <label for="b-comment">Комментарий</label>
            <textarea id="b-comment" name="comment" rows="2" maxlength="500"></textarea>
          </div>
        </div>
      </details>
      <p class="form-error" data-form-error role="alert"></p>
    </div>
    <div class="sheet__foot quick__foot">
      <p class="quick__summary" data-quick-summary>Выберите услугу и время</p>
      <button type="submit" class="btn btn--dark" data-quick-submit disabled>Записать</button>
    </div>
  </form>
</dialog>

<dialog class="admin-dialog client-picker" id="client-picker" aria-labelledby="client-picker-title">
  <div class="sheet">
    <div class="sheet__head">
      <h2 class="sheet__title" id="client-picker-title">Клиентки</h2>
      <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
    </div>
    <div class="sheet__body">
      <input type="search" class="clients-search" placeholder="Имя или номер" aria-label="Поиск клиентки" autocomplete="off" data-picker-search>
      <ul class="client-suggest" data-picker-list aria-label="Клиентки"></ul>
      <p class="muted client-picker__empty" data-picker-empty hidden>Никого не нашлось</p>
    </div>
  </div>
</dialog>
