<% layout('./layout') %>
<%
  const STATUS_FILTER_LABELS = { new: 'Новые', confirmed: 'Подтверждённые', cancelled: 'Отменённые', done: 'Выполненные' };
  const contactHref = (c) => (c.startsWith('@') ? 'https://t.me/' + c.slice(1) : 'tel:' + c.replace(/[^\d+]/g, ''));
%>
<header class="page-head">
  <h1 class="page-title">Записи</h1>
  <button type="button" class="btn btn--dark page-action" data-open-dialog="booking-dialog" aria-label="Добавить запись">
    <svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg><span class="page-action__label">Добавить запись</span>
  </button>
</header>

<nav class="filters" aria-label="Фильтр записей">
  <div class="segmented segmented--full" role="group" aria-label="Период">
<% for (const p of it.periods) { %>
    <a class="segmented__item" href="?period=<%= p.value %><%= it.status ? '&status=' + it.status : '' %>"<%~ p.value === it.period ? ' aria-current="true"' : '' %>><%= p.label %></a>
<% } %>
  </div>
  <div class="chip-scroll" role="group" aria-label="Статус">
    <a class="filter-chip" href="?period=<%= it.period %>"<%~ !it.status ? ' aria-current="true"' : '' %>>Все</a>
<% for (const s of it.statuses) { %>
    <a class="filter-chip" href="?period=<%= it.period %>&status=<%= s.value %>"<%~ s.value === it.status ? ' aria-current="true"' : '' %>>
      <%= STATUS_FILTER_LABELS[s.value] %><% if (s.value === 'new' && it.statusCounts.new) { %> <span class="filter-chip__count"><%= it.statusCounts.new %></span><% } %>
    </a>
<% } %>
  </div>
</nav>

<% if (!it.groups.length) { %>
<div class="panel empty-state">
  <span class="empty-state__icon" aria-hidden="true"><svg><use href="#i-calendar"/></svg></span>
  <p class="empty-state__title">Записей нет</p>
  <p class="muted">Когда клиенты запишутся на сайте, они появятся здесь. Запись по телефону можно добавить кнопкой «+».</p>
</div>
<% } %>

<% for (const group of it.groups) { %>
<section class="day-group" aria-labelledby="d-<%= group.date %>">
  <h2 class="day-group__title" id="d-<%= group.date %>">
    <span><%= group.label %></span>
<% if (group.isToday) { %><span class="tag tag--accent">сегодня</span><% } else if (group.isTomorrow) { %><span class="tag">завтра</span><% } %>
    <span class="day-group__count"><%= group.items.length %></span>
  </h2>
  <ul class="booking-list">
<% for (const b of group.items) { const [start, end] = b.time.split('–'); %>
    <li class="booking-card status-<%= b.status %>" data-row data-booking="<%= b.id %>">
      <div class="booking-card__top">
        <p class="booking-card__time"><%= start %><span class="booking-card__end">–<%= end %></span></p>
        <span class="status-pill" data-status-pill><%= it.statusLabels[b.status] %></span>
      </div>
      <p class="booking-card__service"><%= b.service_title %><% if (b.effect_name) { %> · <%= b.effect_name %><% } %></p>
      <p class="booking-card__client"><%= b.client_name %> <span class="booking-card__price"><%= b.price_byn %> BYN</span></p>
<% if (b.comment) { %><p class="booking-card__comment">«<%= b.comment %>»</p><% } %>

      <div class="booking-card__actions">
        <a class="btn btn--ghost btn--sm booking-card__contact" href="<%= contactHref(b.contact) %>"<%~ b.contact.startsWith('@') ? ' target="_blank" rel="noopener"' : '' %>>
          <svg class="icon" aria-hidden="true"><use href="#<%= b.contact.startsWith('@') ? 'i-telegram' : 'i-phone' %>"/></svg><%= b.contact %>
        </a>
        <button type="button" class="btn btn--dark btn--sm" data-status-to="confirmed" data-show-for="new">Подтвердить</button>
        <button type="button" class="btn btn--dark btn--sm" data-status-to="done" data-show-for="confirmed">Выполнена</button>
        <button type="button" class="btn btn--ghost btn--sm" data-status-to="new" data-show-for="cancelled done">Вернуть в новые</button>
        <button type="button" class="btn btn--ghost btn--sm btn--danger-text" data-status-to="cancelled" data-show-for="new confirmed"
                data-confirm="Отменить запись <%= b.client_name %> на <%= b.time %>? Время снова станет свободным." data-confirm-ok="Отменить запись">Отменить</button>
      </div>
      <p class="booking-card__meta"><%= b.source === 'admin' ? 'добавлена вручную' : 'с сайта' %> · заявка <%= b.createdLocal %></p>
    </li>
<% } %>
  </ul>
</section>
<% } %>

<dialog class="admin-dialog" id="booking-dialog" aria-labelledby="booking-dialog-title">
  <form class="sheet admin-form" data-api action="/admin/api/bookings" data-reset>
    <div class="sheet__head">
      <h2 class="sheet__title" id="booking-dialog-title">Новая запись</h2>
      <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
    </div>
    <div class="sheet__body">
      <div class="form-grid">
        <div class="field field--wide">
          <label for="b-service">Услуга</label>
          <select id="b-service" name="service_id" class="select" required>
            <option value="">Выберите услугу</option>
<% for (const s of it.services) { %>
            <option value="<%= s.id %>"><%= s.title %> · <%= s.price_byn %> BYN · <%= s.duration_min %> мин<%= s.is_active ? '' : ' (скрыта)' %></option>
<% } %>
          </select>
          <p class="field-error" data-error-for="service_id"></p>
        </div>
        <div class="field">
          <label for="b-date">Дата</label>
          <input id="b-date" name="date" type="date" required value="<%= it.today %>">
          <p class="field-error" data-error-for="date"></p>
        </div>
        <div class="field">
          <label for="b-time">Время начала</label>
          <input id="b-time" name="time" type="time" required step="300">
          <p class="field-error" data-error-for="time"></p>
        </div>
        <div class="field">
          <label for="b-name">Имя клиента</label>
          <input id="b-name" name="client_name" required maxlength="60" autocomplete="off">
          <p class="field-error" data-error-for="client_name"></p>
        </div>
        <div class="field">
          <label for="b-contact">Телефон или Telegram</label>
          <input id="b-contact" name="contact" required maxlength="40" inputmode="tel" autocomplete="off">
          <p class="field-error" data-error-for="contact"></p>
        </div>
        <div class="field">
          <label for="b-effect">Эффект</label>
          <select id="b-effect" name="effect_slug" class="select">
            <option value="">Не выбран</option>
<% for (const e of it.effects) { %><option value="<%= e.slug %>"><%= e.name %></option><% } %>
          </select>
        </div>
        <div class="field">
          <label for="b-status">Статус</label>
          <select id="b-status" name="status" class="select">
            <option value="confirmed">Подтверждена</option>
            <option value="new">Новая</option>
          </select>
        </div>
        <div class="field field--wide">
          <label for="b-comment">Комментарий</label>
          <textarea id="b-comment" name="comment" rows="2" maxlength="500"></textarea>
        </div>
        <label class="check field--wide"><input type="checkbox" name="force"> Записать, даже если время занято или вне рабочих часов</label>
      </div>
      <p class="form-error" data-form-error role="alert"></p>
    </div>
    <div class="sheet__foot">
      <button type="button" class="btn btn--ghost" data-close-dialog>Отмена</button>
      <button type="submit" class="btn btn--dark">Добавить запись</button>
    </div>
  </form>
</dialog>
