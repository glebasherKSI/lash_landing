<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#E4E5E8">
  <title><%= it.title %> · Админка</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600&display=swap">
  <link rel="stylesheet" href="<%= it.asset('/css/site.css') %>">
  <link rel="stylesheet" href="<%= it.asset('/css/admin.css') %>">
  <link rel="stylesheet" href="/theme.css">
</head>
<body class="admin" data-csrf="<%= it.csrfToken %>">
  <%~ include('../partials/icons') %>
<%
  // Основные разделы: в нижней панели на телефоне и в боковом меню на компьютере
  const tabs = [
    ['/admin/bookings', 'Записи', 'i-calendar'],
    ['/admin/services', 'Услуги', 'i-lash'],
    ['/admin/works', 'Работы', 'i-image'],
    ['/admin/schedule', 'Расписание', 'i-clock'],
  ];
  const extra = [
    ['/admin/effects', 'Эффекты', 'i-sparkle'],
    ['/admin/settings', 'Настройки', 'i-gear'],
  ];
  const isCurrent = (href) => it.currentPath.startsWith(href);
  const inExtra = extra.some(([href]) => isCurrent(href));
  const initials = (it.studioName || 'OL').split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
%>
  <div class="admin-shell">
    <aside class="admin-side">
      <div class="admin-brand">
        <span class="logo logo--sm" aria-hidden="true"><%= initials %></span>
        <span class="admin-brand__name"><%= it.studioName %></span>
      </div>
      <nav class="admin-nav" aria-label="Разделы админки">
<% for (const [href, label, icon] of [...tabs, ...extra]) { %>
        <a href="<%= href %>"<%~ isCurrent(href) ? ' aria-current="page"' : '' %>>
          <svg class="icon" aria-hidden="true"><use href="#<%= icon %>"/></svg><span><%= label %></span>
<% if (href === '/admin/bookings' && it.newBookings) { %><span class="badge" aria-label="новых: <%= it.newBookings %>"><%= it.newBookings %></span><% } %>
        </a>
<% } %>
      </nav>
      <div class="admin-side__foot">
        <a class="admin-link" href="/" target="_blank" rel="noopener">Открыть сайт <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <form method="post" action="/admin/logout">
          <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
          <button class="admin-link" type="submit">Выйти</button>
        </form>
      </div>
    </aside>

    <main class="admin-main" id="main">
      <%~ it.body %>
    </main>
  </div>

  <nav class="tabbar" aria-label="Разделы админки">
<% for (const [href, label, icon] of tabs) { %>
    <a class="tabbar__item" href="<%= href %>"<%~ isCurrent(href) ? ' aria-current="page"' : '' %>>
      <span class="tabbar__icon"><svg aria-hidden="true"><use href="#<%= icon %>"/></svg>
<% if (href === '/admin/bookings' && it.newBookings) { %><span class="tabbar__badge" aria-label="новых: <%= it.newBookings %>"><%= it.newBookings %></span><% } %>
      </span>
      <span class="tabbar__label"><%= label %></span>
    </a>
<% } %>
    <button type="button" class="tabbar__item" data-open-dialog="more-sheet"<%~ inExtra ? ' aria-current="page"' : '' %>>
      <span class="tabbar__icon"><svg aria-hidden="true"><use href="#i-more"/></svg></span>
      <span class="tabbar__label">Ещё</span>
    </button>
  </nav>

  <dialog class="admin-dialog sheet-menu" id="more-sheet" aria-labelledby="more-title">
    <div class="sheet">
      <div class="sheet__head">
        <h2 class="sheet__title" id="more-title">Ещё</h2>
        <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
      </div>
      <div class="sheet__body">
        <ul class="menu-list">
<% for (const [href, label, icon] of extra) { %>
          <li><a class="menu-item" href="<%= href %>"<%~ isCurrent(href) ? ' aria-current="page"' : '' %>><span class="menu-item__icon"><svg aria-hidden="true"><use href="#<%= icon %>"/></svg></span><%= label %><svg class="menu-item__go" aria-hidden="true"><use href="#i-chevron-right"/></svg></a></li>
<% } %>
          <li><a class="menu-item" href="/" target="_blank" rel="noopener"><span class="menu-item__icon"><svg aria-hidden="true"><use href="#i-globe"/></svg></span>Открыть сайт<svg class="menu-item__go" aria-hidden="true"><use href="#i-arrow"/></svg></a></li>
          <li>
            <form method="post" action="/admin/logout">
              <input type="hidden" name="_csrf" value="<%= it.csrfToken %>">
              <button class="menu-item menu-item--danger" type="submit"><span class="menu-item__icon"><svg aria-hidden="true"><use href="#i-logout"/></svg></span>Выйти</button>
            </form>
          </li>
        </ul>
      </div>
    </div>
  </dialog>

  <div class="toast" role="status" aria-live="polite" hidden></div>

  <dialog class="confirm-dialog" id="confirm-dialog" aria-labelledby="confirm-text">
    <form method="dialog" class="confirm-dialog__body">
      <p id="confirm-text" class="confirm-dialog__text"></p>
      <div class="confirm-dialog__actions">
        <button class="btn btn--ghost" value="cancel">Отмена</button>
        <button class="btn btn--danger" value="ok">Удалить</button>
      </div>
    </form>
  </dialog>

  <script type="module" src="<%= it.asset('/js/admin.js') %>"></script>
</body>
</html>
