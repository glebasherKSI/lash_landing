<% layout('./layout') %>
<header class="page-head">
  <h1 class="page-title">Услуги</h1>
  <button type="button" class="btn btn--dark page-action" data-edit-service aria-label="Добавить услугу">
    <svg class="icon" aria-hidden="true"><use href="#i-plus"/></svg><span class="page-action__label">Добавить услугу</span>
  </button>
</header>

<section class="panel" aria-labelledby="services-list-title" data-reorder-scope>
  <div class="panel__bar">
    <h2 class="h3" id="services-list-title">Прайс</h2>
    <button type="button" class="btn btn--ghost btn--sm" data-reorder-toggle aria-pressed="false">
      <svg class="icon" aria-hidden="true"><use href="#i-sort"/></svg><span data-reorder-label>Порядок</span>
    </button>
  </div>
  <p class="muted panel__hint" data-reorder-hint hidden>Стрелками поменяйте порядок, как на сайте. Сохраняется сразу.</p>
<% if (!it.services.length) { %>
  <p class="empty">Услуг пока нет. Нажмите «+», чтобы добавить первую.</p>
<% } %>
  <ul class="sort-list" data-sortable="/admin/api/services/reorder">
<% for (const s of it.services) { %>
    <li class="list-row service-row<%= s.is_active ? '' : ' is-off' %>" data-id="<%= s.id %>" data-row>
      <span class="drag-handle" aria-hidden="true">⋮⋮</span>
      <button type="button" class="list-row__main" data-edit-service='<%= JSON.stringify(s) %>' aria-label="Изменить «<%= s.title %>»">
        <span class="swatch g-<%= s.gradient %>" aria-hidden="true"></span>
        <span class="list-row__text">
          <span class="list-row__title"><%= s.title %><% if (s.is_popular) { %> <span class="tag tag--accent">популярное</span><% } %></span>
          <span class="list-row__meta"><b><%= s.price_byn %> BYN</b> · <%= it.formatDuration(s.duration_min) %><%= s.category_name ? ' · ' + s.category_name : '' %><%= s.is_active ? '' : ' · скрыта' %></span>
        </span>
      </button>
      <label class="switch list-row__switch" title="Показывать на сайте">
        <input type="checkbox" data-toggle-url="/admin/api/services/<%= s.id %>/toggle"<%~ s.is_active ? ' checked' : '' %>>
        <span class="sr-only">Показывать «<%= s.title %>» на сайте</span>
      </label>
      <span class="move-btns">
        <button type="button" class="icon-btn icon-btn--plain" data-move="up" aria-label="Выше: <%= s.title %>"><svg aria-hidden="true"><use href="#i-up"/></svg></button>
        <button type="button" class="icon-btn icon-btn--plain" data-move="down" aria-label="Ниже: <%= s.title %>"><svg aria-hidden="true"><use href="#i-down"/></svg></button>
      </span>
    </li>
<% } %>
  </ul>
</section>

<section class="panel" aria-labelledby="categories-title" data-reorder-scope>
  <div class="panel__bar">
    <h2 class="h3" id="categories-title">Вкладки на сайте</h2>
    <button type="button" class="btn btn--ghost btn--sm" data-reorder-toggle aria-pressed="false">
      <svg class="icon" aria-hidden="true"><use href="#i-sort"/></svg><span data-reorder-label>Порядок</span>
    </button>
  </div>
  <p class="muted panel__hint">Заголовки над карточками услуг. Пустые вкладки на сайте не показываются.</p>
  <ul class="sort-list" data-sortable="/admin/api/categories/reorder">
<% for (const c of it.categories) { %>
    <li class="list-row" data-id="<%= c.id %>" data-row>
      <span class="drag-handle" aria-hidden="true">⋮⋮</span>
      <form class="inline-form" data-api action="/admin/api/categories/<%= c.id %>">
        <label class="sr-only" for="cat-<%= c.id %>">Название вкладки</label>
        <input id="cat-<%= c.id %>" name="name" value="<%= c.name %>" required maxlength="40">
        <button class="icon-btn icon-btn--plain" type="submit" aria-label="Сохранить название"><svg aria-hidden="true"><use href="#i-check"/></svg></button>
        <button type="button" class="icon-btn icon-btn--plain icon-btn--danger" data-api-post="/admin/api/categories/<%= c.id %>/delete"
                data-confirm="Удалить вкладку «<%= c.name %>»? Услуги из неё останутся, но окажутся без вкладки." data-reload aria-label="Удалить вкладку «<%= c.name %>»"><svg aria-hidden="true"><use href="#i-trash"/></svg></button>
      </form>
      <span class="move-btns">
        <button type="button" class="icon-btn icon-btn--plain" data-move="up" aria-label="Выше: <%= c.name %>"><svg aria-hidden="true"><use href="#i-up"/></svg></button>
        <button type="button" class="icon-btn icon-btn--plain" data-move="down" aria-label="Ниже: <%= c.name %>"><svg aria-hidden="true"><use href="#i-down"/></svg></button>
      </span>
    </li>
<% } %>
  </ul>
  <form class="inline-form inline-form--add" data-api action="/admin/api/categories" data-reload>
    <label class="sr-only" for="cat-new">Новая вкладка</label>
    <input id="cat-new" name="name" placeholder="Новая вкладка, например «Уход»" required maxlength="40">
    <button class="btn btn--dark btn--sm" type="submit">Добавить</button>
    <p class="field-error" data-error-for="name"></p>
  </form>
</section>

<dialog class="admin-dialog" id="service-dialog" aria-labelledby="service-dialog-title">
  <form class="sheet admin-form" data-api action="/admin/api/services" data-reload id="service-form">
    <div class="sheet__head">
      <h2 class="sheet__title" id="service-dialog-title">Услуга</h2>
      <button type="button" class="icon-btn" data-close-dialog aria-label="Закрыть"><svg aria-hidden="true"><use href="#i-close"/></svg></button>
    </div>
    <div class="sheet__body">
      <div class="form-grid">
        <div class="field field--wide">
          <label for="s-title">Название</label>
          <input id="s-title" name="title" required maxlength="80">
          <p class="field-error" data-error-for="title"></p>
        </div>
        <div class="field">
          <label for="s-price">Цена, BYN</label>
          <input id="s-price" name="price_byn" type="number" min="0" max="10000" step="1" inputmode="numeric" required>
          <p class="field-error" data-error-for="price_byn"></p>
        </div>
        <div class="field">
          <label for="s-duration">Длительность, минут</label>
          <input id="s-duration" name="duration_min" type="number" min="15" max="600" step="5" inputmode="numeric" required>
          <p class="field-error" data-error-for="duration_min"></p>
        </div>
        <div class="field field--wide">
          <label for="s-desc">Описание</label>
          <textarea id="s-desc" name="description" rows="3" maxlength="400"></textarea>
          <p class="field-error" data-error-for="description"></p>
        </div>
        <div class="field">
          <label for="s-category">Вкладка</label>
          <select id="s-category" name="category_id" class="select">
            <option value="">Без вкладки</option>
<% for (const c of it.categories) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
          </select>
        </div>
        <div class="field">
          <label for="s-tile">Размер плитки</label>
          <select id="s-tile" name="tile" class="select">
<% for (const t of it.tiles) { %><option value="<%= t.value %>"><%= t.label %></option><% } %>
          </select>
        </div>
        <fieldset class="field field--wide swatches">
          <legend>Цвет карточки</legend>
<% for (const g of it.gradients) { %>
          <label class="swatch-option">
            <input type="radio" name="gradient" value="<%= g.value %>">
            <span class="swatch swatch--lg g-<%= g.value %>" aria-hidden="true"></span>
            <span><%= g.label %></span>
          </label>
<% } %>
        </fieldset>
        <label class="check-row field--wide"><span>Популярное</span><span class="switch"><input type="checkbox" name="is_popular"></span></label>
        <label class="check-row field--wide"><span>Показывать на сайте</span><span class="switch"><input type="checkbox" name="is_active" checked></span></label>
      </div>
      <p class="form-error" data-form-error role="alert"></p>
    </div>
    <div class="sheet__foot">
      <button type="button" class="icon-btn icon-btn--plain icon-btn--danger sheet__delete" data-service-delete hidden aria-label="Удалить услугу"
              data-confirm="Удалить эту услугу? Прошлые записи на неё сохранятся." data-reload><svg aria-hidden="true"><use href="#i-trash"/></svg></button>
      <button type="button" class="btn btn--ghost" data-close-dialog>Отмена</button>
      <button type="submit" class="btn btn--dark">Сохранить</button>
    </div>
  </form>
</dialog>
